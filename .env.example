# ==========================================
# Jupyter Server Connection
# ==========================================
JUPYTER_SERVER_URL="https://your-jupyter-domain.com"
JUPYTER_TOKEN="your_jupyter_secret_token"
JUPYTER_KERNEL_NAME="python3"

# ==========================================
# MCP Bridge Server Settings
# ==========================================
# Transport mode: "stdio" (local/agent CLI) or "sse" (remote HTTP)
MCP_TRANSPORT="sse"
PORT="8080"

# Optional: Protect remote MCP endpoint with an API key (Bearer token or ?key=...)
BRIDGE_API_KEY=""

# User-Agent header for reverse proxy / Cloudflare compatibility
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
